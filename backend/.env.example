NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongodb:27017/realestatecrm
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3002
# Required for first-admin setup; replace this placeholder with a real secret. There is no default.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-secret
# Demo seed credentials are required; replace placeholders. There are no defaults.
DEMO_ADMIN_EMAIL=demo-admin@example.test
DEMO_ADMIN_PASSWORD=replace-with-demo-admin-password
DEMO_AGENT_EMAIL=demo-agent@example.test
DEMO_AGENT_PASSWORD=replace-with-demo-agent-password
